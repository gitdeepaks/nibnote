{
  "name": "nibnote",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "19.3.0",
      "zod": "4.6.5",
      "typescript": "6.0.3",
      "eslint": "10.11.0",
      "typescript-eslint": "8.70.1",
      "jiti": "2.7.0",
      "hono": "4.13.9",
      "@types/bun": "1.4.2",
      "drizzle-orm": "0.45.3"
    }
  },
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "2.1.14",
    "prettier": "3.9.9"
  },
  "packageManager": "bun@1.4.0"
}
