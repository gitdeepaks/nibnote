{
  "extends": ["expo/tsconfig.base", "@nibnote/config/tsconfig.base.json"],
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "eslint.config.ts", "modules/*/ios", "modules/*/android"]
}
