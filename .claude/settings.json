{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/packages/config/scripts/check-edited-package.ts\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
